# ==============================================
# TechMart Backend - Environment Variables
# ==============================================

# ==============================================
# DATABASE
# ==============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techmart?schema=public"

# ==============================================
# REDIS CACHE
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_TLS=true  # Uncomment for production with TLS

# ==============================================
# JWT AUTHENTICATION
# ==============================================
# IMPORTANT: Use strong secrets (min 32 characters) in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================
# GOOGLE AI (GEMINI)
# ==============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
# Optional: Specify model (default: gemini-1.5-flash)
# GOOGLE_AI_MODEL=gemini-1.5-flash

# ==============================================
# STRIPE PAYMENT
# ==============================================
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key  # For production
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ==============================================
# CLOUDINARY (IMAGE UPLOAD)
# ==============================================
# Get your credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==============================================
# FRONTEND URL
# ==============================================
FRONTEND_URL=http://localhost:3000
# FRONTEND_URL=https://your-frontend-domain.com  # For production

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=3001
NODE_ENV=development
# NODE_ENV=production  # For production

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=https://your-frontend.com,https://www.your-frontend.com  # For production

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# AI endpoints have separate limits (configured in code)

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=debug
# LOG_LEVEL=info  # For production

# ==============================================
# MONITORING & ERROR TRACKING
# ==============================================
# Sentry (Optional)
# Get DSN from: https://sentry.io
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Prometheus Metrics
METRICS_ENABLED=true

# ==============================================
# EMAIL SERVICE (OPTIONAL)
# ==============================================
# Resend (https://resend.com)
# RESEND_API_KEY=re_your-resend-api-key
# EMAIL_FROM=noreply@techmart.com

# ==============================================
# SESSION & COOKIES
# ==============================================
SESSION_SECRET=your-session-secret-change-this-in-production
COOKIE_DOMAIN=localhost
# COOKIE_DOMAIN=.your-domain.com  # For production
COOKIE_SECURE=false
# COOKIE_SECURE=true  # For production (HTTPS only)

# ==============================================
# FEATURE FLAGS
# ==============================================
ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false  # Disable in production for security
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true

# ==============================================
# CACHE TTL (Time To Live in seconds)
# ==============================================
CACHE_TTL_PRODUCTS=300
CACHE_TTL_CATEGORIES=900
CACHE_TTL_USER=3600

# ==============================================
# FILE UPLOAD LIMITS
# ==============================================
MAX_FILE_SIZE=5242880
# 5MB = 5 * 1024 * 1024 bytes

# ==============================================
# PAGINATION
# ==============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ==============================================
# SECURITY
# ==============================================
# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=10

# CSRF Protection
CSRF_SECRET=your-csrf-secret-change-this

# ==============================================
# THIRD-PARTY INTEGRATIONS (OPTIONAL)
# ==============================================
# Google Analytics
# GA_TRACKING_ID=G-XXXXXXXXXX

# Meta Pixel
# META_PIXEL_ID=your-pixel-id

# Hotjar
# HOTJAR_ID=your-hotjar-id

# Mailchimp
# MAILCHIMP_API_KEY=your-mailchimp-api-key
# MAILCHIMP_LIST_ID=your-list-id

# ==============================================
# DEVELOPMENT ONLY
# ==============================================
# Debug mode
DEBUG=false

# Database logging
DATABASE_LOGGING=false

# ==============================================
# NOTES
# ==============================================
# 1. NEVER commit this file with real credentials
# 2. Copy this file to .env and fill in your values
# 3. Add .env to .gitignore
# 4. Use strong secrets in production (min 32 characters)
# 5. Enable HTTPS in production (COOKIE_SECURE=true)
# 6. Disable Swagger in production (ENABLE_SWAGGER=false)
# 7. Use environment-specific values for DATABASE_URL and REDIS_HOST
# 8. Rotate secrets regularly
# 9. Use a secrets manager in production (AWS Secrets Manager, etc.)
# 10. Validate all environment variables on startup
